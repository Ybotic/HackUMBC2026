{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "solana-mcp": {
        "type": "remote",
        "url": "https://mcp.solana.com/mcp"
      },
      "convex": {
        "type": "local",
        "command": ["npx", "-y", "convex@latest", "mcp", "start"]
      }
    }
  }
}
