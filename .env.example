# for ipfs uploads
PINATA_JWT=
NEXT_PUBLIC_GATEWAY_URL=

# Optional custom Vercel Blob credentials. Vercel-hosted code can use OIDC
# automatically through BLOB_STORE_ID; Convex image generation uses this token.
# MINT_STORE_ID=
# MINT_READ_WRITE_TOKEN=
# Static-token fallback if you prefer the SDK's default variable name:
# BLOB_READ_WRITE_TOKEN=

# Image generation
IMAGE_GENERATION_MODEL=

# convex
NEXT_PUBLIC_CONVEX_URL=
# Optional; `convex dev` can populate this
# CONVEX_DEPLOYMENT=

# vercel convex
# Optional; only needed for automated/prod deployment
# CONVEX_DEPLOY_KEY=

# Solana (defaults to devnet)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
